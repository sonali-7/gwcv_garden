# Local JSON store is used when MONGODB_URI is empty.
MONGODB_URI=
MONGODB_DB=gwcv_garden

# Optional AI. Texts, photo captions, and Import drawing's handwriting use Gemini when GEMINI_API_KEY is set.
# Texts and captions use Claude when only ANTHROPIC_API_KEY is set. With neither, texts are parsed by rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Tried when GEMINI_MODEL is busy or slow (texts and captions).
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional. The on-screen phone works without these.
# Beta docs: https://photon.codes/docs/beta
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_WEBHOOK_SECRET=
# Replies per volunteer per day over iMessage. Each incoming text gets at most one reply.
PHOTON_DAILY_LIMIT=100
GARDEN_TZ=America/New_York
