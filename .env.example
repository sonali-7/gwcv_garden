# Local JSON store is used when MONGODB_URI is empty.
MONGODB_URI=
MONGODB_DB=gwcv_garden

# Optional. Photo captions use this when set. Texts are parsed without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional. Reads handwriting in Import drawing. Without it you type bed names.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional. The on-screen phone works without these.
# Beta docs: https://photon.codes/docs/beta
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_WEBHOOK_SECRET=
GARDEN_TZ=America/New_York
